HEAVY_DIGITS = {0, 1, 3, 4, 7, 8, 9}
FILLER_DIGITS = {2, 5, 6}


def to_digits(n: str) -> list[int]:
    return [int(d) for d in n]


def from_digits(digs: list[int]) -> str:
    return "".join(str(d) for d in digs)


def mirror_digits(digs: list[int]) -> list[int]:
    # add 5 mod 10 to each digit
    return [(d + 5) % 10 for d in digs]


def flip_digits(digs: list[int]) -> list[int]:
    return list(reversed(digs))


def classify_digits(digs: list[int]) -> dict:
    heavy = [d for d in digs if d in HEAVY_DIGITS]
    fillers = [d for d in digs if d in FILLER_DIGITS]
    return {
        "heavy": heavy,
        "fillers": fillers,
        "heavy_count": len(heavy),
        "filler_count": len(fillers),
    }


def build_bias_rows(base_digits: list[int]) -> list[str]:
    """
    Simple bias: swap heavy digits into position 0 (P1)
    and a few into position 1 (P2).
    """
    rows = set()

    # P1 bias
    for h in HEAVY_DIGITS:
        new = base_digits.copy()
        new[0] = h
        rows.add(from_digits(new))

    # P2 bias (if length > 1)
    if len(base_digits) > 1:
        for h in HEAVY_DIGITS:
            new = base_digits.copy()
            new[1] = h
            rows.add(from_digits(new))

    return sorted(rows)


def universal_rundown_pick4(draw: str) -> dict:
    """
    Core engine for Director/Universe Mode.
    Input: last Pick-4 draw as string, e.g. "1661"
    Output: dict with base/mirror/flip, bias rows, and digit classification.
    """
    digs = to_digits(draw)

    base = digs
    mirror = mirror_digits(digs)
    flip = flip_digits(digs)

    base_str = from_digits(base)
    mirror_str = from_digits(mirror)
    flip_str = from_digits(flip)

    bias_rows = build_bias_rows(base)

    # classify digits in the original draw
    classification = classify_digits(digs)

    # build a simple prediction band: unique heavy digits seen
    prediction_band = sorted(set(classification["heavy"]))

    return {
        "input_draw": draw,
        "base": base_str,
        "mirror": mirror_str,
        "flip": flip_str,
        "bias_rows": bias_rows,
        "classification": classification,
        "prediction_band": prediction_band,
    }


